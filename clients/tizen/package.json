{
  "name": "onscreen-tizen",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 5175",
    "build": "vite build && node scripts/rewrite-file-paths.mjs && node scripts/assemble-package.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5175",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "package": "npm run build && node scripts/package.mjs",
    "install-tv": "node scripts/sideload.mjs",
    "launch-tv": "node scripts/launch.mjs",
    "install-emu": "node scripts/sideload.mjs --emu",
    "launch-emu": "node scripts/launch.mjs --emu",
    "dev:emu": "npm run package && npm run install-emu && npm run launch-emu"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "hls.js": "^1.7.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
