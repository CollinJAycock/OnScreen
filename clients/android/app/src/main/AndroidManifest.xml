<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- WAKE_LOCK lets ExoPlayer hold a CPU wake lock during playback
         (setWakeMode(WAKE_MODE_LOCAL) in PlaybackFragment). The
         screen-on flag is window-level and doesn't need a permission. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Background music plays through OnScreenMediaSessionService, a
         mediaPlayback foreground service. FOREGROUND_SERVICE is required
         since API 28; FOREGROUND_SERVICE_MEDIA_PLAYBACK is required on
         API 34+ (media3 1.3.1 doesn't declare it for us). Without these,
         Media3 promoting the service to foreground throws SecurityException
         on Android 14+ TVs. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- API 33+ gates notifications behind a runtime permission. The media
         notification Media3 posts for OnScreenMediaSessionService is the ONLY
         control surface for audio that deliberately keeps playing after the
         player screen is gone, so without this the user has no way to pause
         backgrounded music. MainActivity requests it at startup on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets WatchNextManager publish + remove rows in the system's
         WatchNextPrograms content provider so resumable items show
         up in Google TV's "Continue Watching" row across launchers
         (TV-PN quality compliance). The READ permission is only
         needed when querying for our own existing rows; without it
         we'd insert duplicate entries on every progress tick. -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />

    <!-- required="true" is the DEFAULT (googletv / Play) posture, and it lives
         here rather than in a flavor overlay on purpose.

         Play uses this for device targeting. With required="false" the AAB was
         eligible for PHONES, where it installs and then has nothing to launch,
         because MainActivity below declares only LEANBACK_LAUNCHER — that is
         how early-access testers ended up with an Uninstall-only listing and
         no app icon. Every certified Android TV / Google TV device reports
         leanback, so requiring it costs no coverage there.

         The firetv flavor overrides this back to false
         (src/firetv/AndroidManifest.xml): a number of Amazon Fire TV / Fire OS
         devices do not report leanback, so requiring it lets the Amazon
         Appstore filter the app off them and can block sideload.

         The value is a per-flavor manifest placeholder rather than a flavor
         OVERLAY so that this declaration, the touchscreen line below, and the
         LEANBACK_LAUNCHER activity all stay in ONE source set. Lint evaluates
         an overlay in isolation and cannot see across source sets, so putting
         the leanback flag in a flavor manifest trips MissingLeanbackLauncher
         and ImpliedTouchscreenHardware as false positives on whichever flavor
         carries it. See productFlavors in app/build.gradle.kts. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="${leanbackRequired}" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- Amazon Fire TV runs Fire OS (an Android fork) and accepts
         the same APK as Google TV. This feature declaration is
         what Amazon's launcher reads to classify the app under
         the TV category in the Amazon Appstore; on a stock
         Android TV / Google TV device it's an unknown feature
         and ignored (required="false" makes it a no-op there).
         See clients/firetv/README.md for the Fire TV-specific
         build / sideload / store-submission workflow. -->
    <uses-feature
        android:name="amazon.hardware.fire_tv"
        android:required="false" />

    <!-- enableOnBackInvokedCallback="false": keep LEGACY back dispatch.

         From targetSdk 36 on an Android 16+ device the attribute defaults to
         TRUE, and then the platform stops dispatching KEYCODE_BACK to the view
         tree and to Activity.dispatchKeyEvent altogether — ViewRootImpl hands
         the press straight to the top OnBackInvokedCallback (in practice the
         FragmentManager's back-stack pop, or finishing the task). Nothing about
         that is touch- or gesture-specific, so a TV remote's BACK key goes the
         same way on an Android TV / Google TV 16 box.

         The player's BACK handling still lives on that key path, and it is not
         ours to migrate — it is inside Leanback 1.0.0 (confirmed in the
         bytecode, both View-level key listeners on KEYCODE_BACK):
           - PlaybackSupportFragment consumes BACK to HIDE the transport
             controls while they are showing; only the next press exits;
           - the transport row's seek bar consumes BACK to CANCEL a scrub.
         Under the new dispatch both become "BACK pops the player" in the
         middle of the interaction. The app-owned player overlays (Skip
         intro/credits, Up Next) are handled by an OnBackPressedCallback in
         PlaybackFragment, so they are correct under either dispatch; this
         opt-out is the safety net for the library-owned paths. (The photo
         viewer's activity-level BACK branch lands on the same result either
         way: without it the FragmentManager pops the same entry, and the
         slideshow is view-scoped.)

         Still honoured on Android 16, and a no-op below Android 13 (API 33),
         where legacy dispatch is the only behaviour anyway. Revisit (drop the
         opt-out) once Leanback's player handles BACK through
         OnBackPressedDispatcher or the platform stops honouring it.
         tools:targetApi="33" only silences lint's UnusedAttribute for that
         below-33 no-op. -->
    <application
        android:name=".OnScreenApp"
        android:enableOnBackInvokedCallback="false"
        tools:targetApi="33"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:banner="@drawable/ic_banner_art"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OnScreen">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|keyboard|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Deep-link entry point. Watch Next launcher tiles
                 publish onscreen://watch/<item_id>?position=<ms>
                 URIs; MainActivity reads the path + query in
                 onCreate / onNewIntent and routes straight into
                 PlaybackFragment with a resume offset.
                 Deliberately NOT BROWSABLE: the launcher fires the tile's
                 intent URI without that category, and BROWSABLE would let any
                 web page in the TV's browser (Silk etc.) force auto-playback
                 of an arbitrary item and clobber its resume position. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="onscreen" android:host="watch" />
            </intent-filter>
        </activity>

        <!-- MediaSessionService: hosts ExoPlayer when audio playback
             continues outside the PlaybackFragment so navigating to
             another screen doesn't stop music. PlaybackFragment binds
             via MediaController; the service owns the player. -->
        <service
            android:name=".playback.OnScreenMediaSessionService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
