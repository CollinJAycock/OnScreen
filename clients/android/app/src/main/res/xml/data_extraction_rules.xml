<?xml version="1.0" encoding="utf-8"?>
<!--
  Data-extraction rules for Android 12+ (API 31+). Two surfaces:

  - <cloud-backup>: Google Drive backup. Already gated by
    AndroidManifest's `android:allowBackup="false"`, but we declare
    exclude rules anyway as defense-in-depth.
  - <device-transfer>: phone-to-phone / TV-to-TV migration ("set up
    your new device by copying from the old one"). This runs
    independently of allowBackup — even with cloud backup off, D2D
    transfer can ship the entire app data dir. The auth tokens live
    in DataStore and would otherwise migrate with the box, which means
    a TV passed on to another person could carry the previous owner's
    credentials.

  Excluding the datastore + sharedpref roots from BOTH surfaces ensures
  auth credentials never leave the device they were minted on. The
  user re-logs-in after a device swap, which is the correct security
  posture for a self-hosted media server.

  See: https://developer.android.com/about/versions/12/backup-restore
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
