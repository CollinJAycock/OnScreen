<?xml version="1.0" encoding="utf-8"?>
<!--
    Pairing screen. Displays the URL the user goes to on a second
    device (phone/laptop), the PIN they type there, and a status
    line that flips between "Waiting for sign-in...", "Code expired",
    and "Couldn't reach server" while the fragment polls
    /api/v1/auth/pair/poll in the background.

    Sized for the 960x540dp TV design viewport WITH overscan margins:
    the previous fixed budget (160dp padding + 248dp margins + 210sp of
    text) came to ~666dp of children in a 540dp-tall window, so
    LinearLayout's centering absorbed all the padding and pushed the
    title and Cancel button into the ~5% overscan band some panels
    crop. ScrollView keeps everything reachable even on odd densities.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="48dp"
        android:paddingVertical="27dp">

        <TextView
            android:id="@+id/pair_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pair_title"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pair_instructions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/text_secondary"
            android:textSize="20sp"
            android:gravity="center"
            android:text="@string/pair_instructions" />

        <TextView
            android:id="@+id/pair_url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/accent"
            android:textSize="28sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/pair_pin_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:textAllCaps="true"
            android:letterSpacing="0.15"
            android:text="@string/pair_pin_label" />

        <!-- The PIN is the headline element. Render large, monospaced,
             and tracked-out so it reads from the couch. 64sp still reads
             across the room and buys back 32sp of the vertical budget. -->
        <TextView
            android:id="@+id/pair_pin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_primary"
            android:textSize="64sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.2" />

        <TextView
            android:id="@+id/pair_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end" />

        <Button
            android:id="@+id/pair_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minWidth="200dp"
            android:background="@drawable/btn_secondary"
            android:textColor="@color/text_primary"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="@android:string/cancel" />

    </LinearLayout>
</ScrollView>
