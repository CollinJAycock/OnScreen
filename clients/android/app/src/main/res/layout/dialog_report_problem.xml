<?xml version="1.0" encoding="utf-8"?>
<!--
    "Report a problem" dialog body (ReportProblemDialog). Three panels, one
    visible at a time: the kind list (buttons added in code, one per kind),
    the optional-note step, and the thank-you. D-pad only: every action is a
    focusable button with the pill focus ring.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/report_subject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- Earlier reports ("You reported … 2 days ago") or the loading line. -->
        <TextView
            android:id="@+id/report_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:alpha="0.85"
            android:lineSpacingExtra="4dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/report_kinds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="@string/report_problem_whats_wrong" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/report_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/report_note_kind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:text="@string/report_problem_note_label" />

            <EditText
                android:id="@+id/report_note_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/report_problem_note_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:imeOptions="actionDone"
                android:maxLines="3"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/report_send"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:paddingHorizontal="28dp"
                    android:background="@drawable/btn_pill_secondary"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:focusable="true"
                    android:text="@string/report_problem_send" />

                <Button
                    android:id="@+id/report_back"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="14dp"
                    android:paddingHorizontal="28dp"
                    android:background="@drawable/btn_pill_secondary"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textAllCaps="false"
                    android:focusable="true"
                    android:text="@string/report_problem_back" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/report_sent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:visibility="gone"
            android:text="@string/report_problem_sent" />
    </LinearLayout>
</ScrollView>
