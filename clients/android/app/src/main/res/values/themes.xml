<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OnScreen" parent="Theme.Leanback">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/accent_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="defaultBrandColor">@color/accent</item>
        <item name="defaultBrandColorDark">@color/accent_dark</item>
        <item name="defaultSearchColor">@color/accent</item>
        <item name="defaultSearchBrightColor">@color/accent</item>
        <item name="overlayDimMaskColor">@android:color/transparent</item>
        <item name="overlayDimActiveLevel">0%</item>
        <item name="overlayDimDimmedLevel">0%</item>
        <!-- How long the player's controls stay up after the last key press
             before they fade, while something plays (video, music or a
             book). PlaybackSupportFragment reads
             it from this theme. Leanback 1.0.0 leaves it at 0, which is "never":
             its tickle() on every D-pad press cancelled the fade for good, and
             so did the player's own tickle when playback started or resumed
             (PlaybackFragment.syncControlsAutoHide), so the controls never
             faded. Longer than the 3 s fade after playback starts
             (playbackControlsAutoHideTimeout), as Leanback advises. -->
        <item name="playbackControlsAutoHideTickleTimeout">5000</item>
    </style>

    <style name="PlayerDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>
</resources>
