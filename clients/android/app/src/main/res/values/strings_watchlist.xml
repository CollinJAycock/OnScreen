<?xml version="1.0" encoding="utf-8"?>
<!-- Watchlist screen (v2.6): one row per watch-status, from GET
     /api/v1/watchlist. Kept in its own file like strings_watch_state.xml. -->
<resources>
    <string name="watchlist">Watchlist</string>

    <!-- Row labels, in row order -->
    <string name="watchlist_plan_to_watch">Plan to Watch</string>
    <string name="watchlist_watching">Watching</string>
    <string name="watchlist_on_hold">On Hold</string>
    <string name="watchlist_completed">Completed</string>
    <string name="watchlist_dropped">Dropped</string>
    <!-- Row header: label + that status's count, e.g. "Plan to Watch (12)" -->
    <string name="watchlist_row_header">%1$s (%2$d)</string>

    <string name="empty_watchlist_title">Nothing on your watchlist yet</string>
    <!-- Statuses are set with the Status action on a title's details page,
         and moved / removed here with a long-press. -->
    <string name="empty_watchlist_message">Add a title with Status on its page. Long-press a card here to move or remove it.</string>

    <!-- Card long-press menu (also the details page's Status picker) -->
    <string name="watchlist_move_to">Move to %1$s</string>
    <string name="watchlist_remove">Remove from Watchlist</string>
    <string name="watchlist_change_failed">Couldn\'t update the status</string>

    <!-- Details page Status action: the button, and its picker's title -->
    <string name="status_add">Add to Watchlist</string>
    <!-- e.g. "Status: Plan to Watch" -->
    <string name="status_label">Status: %1$s</string>
    <string name="status_title">Status</string>
</resources>
