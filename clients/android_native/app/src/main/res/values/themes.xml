<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns the rendered theme; the AndroidManifest theme
         sets the splash/window background to match the dark Compose
         surface before the first frame. It is an AppCompat theme because
         the Cast device picker is an AppCompatDialog in a DialogFragment
         themed from this activity (not from the route button's wrapper
         below): it throws without Theme.AppCompat, and mediarouter throws
         on a translucent (undefined) colorPrimary. -->
    <style name="Theme.OnScreenMobile" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">#FF7C6AF7</item>
        <item name="colorPrimaryDark">#FF5A4ED4</item>
        <item name="colorAccent">#FF7C6AF7</item>
    </style>

    <!-- mediarouter's MediaRouterThemeHelper.getControllerColor reads
         `?androidx.appcompat:attr/colorPrimary` from the inflating
         context and runs it through ColorUtils.calculateContrast,
         which throws IllegalArgumentException when the value is
         translucent. The Compose-only host theme doesn't define
         colorPrimary, so the lookup returns 0 (#00000000). Parent on
         a full AppCompat theme that defines all the colour attrs
         mediarouter and the Cast SDK introspect, and pin colorPrimary
         + android:colorBackground to opaque values so the contrast
         helper succeeds. -->
    <style name="Theme.OnScreen.MediaRoute" parent="Theme.AppCompat.DayNight">
        <item name="colorPrimary">#FF7C6AF7</item>
        <item name="colorPrimaryDark">#FF5A4ED4</item>
        <item name="colorAccent">#FF7C6AF7</item>
        <item name="android:colorBackground">#FF0E1117</item>
    </style>
</resources>
