{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OnScreen",
  "version": "2.5.1",
  "identifier": "com.onscreen.desktop",
  "build": {
    "frontendDist": "../../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "OnScreen",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; media-src 'self' blob: https: http:; connect-src 'self' ipc: http://ipc.localhost https: http: ws: wss:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "OnScreen",
    "category": "Video",
    "shortDescription": "OnScreen media client",
    "longDescription": "Native desktop client for the OnScreen media server. Audiophile-grade playback (bit-perfect, gapless) and full feature parity with the web UI.",
    "windows": {
      "wix": {
        "upgradeCode": "8e8c035e-2aaa-58d0-8a7d-85585a6e84d8"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": ["libasound2t64 | libasound2", "libdbus-1-3"],
        "recommends": ["gstreamer1.0-libav", "gstreamer1.0-plugins-bad"]
      },
      "rpm": {
        "depends": ["libasound.so.2()(64bit)", "libdbus-1.so.3()(64bit)"]
      }
    }
  }
}
