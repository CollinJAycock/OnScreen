msgctxt "#30001"
msgid "Server address"
msgstr "服务器地址"

msgctxt "#30002"
msgid "The address of your OnScreen server, such as http://192.168.1.10:7070 or https://media.example.com."
msgstr "你的 OnScreen 服务器地址，例如 http://192.168.1.10:7070 或 https://media.example.com。"

msgctxt "#30003"
msgid "Sign in"
msgstr "登录"

msgctxt "#30004"
msgid "Sign out"
msgstr "退出登录"

msgctxt "#30005"
msgid "Change server…"
msgstr "更换服务器…"

msgctxt "#30006"
msgid "Server"
msgstr "服务器"

msgctxt "#30007"
msgid "Server and account"
msgstr "服务器和账户"

msgctxt "#30010"
msgid "Playback"
msgstr "播放"

msgctxt "#30011"
msgid "What this device plays"
msgstr "此设备可播放的内容"

msgctxt "#30012"
msgid "Highest resolution"
msgstr "最高分辨率"

msgctxt "#30013"
msgid "The server scales larger videos down to this."
msgstr "服务器会把更大的视频缩小到此分辨率。"

msgctxt "#30014"
msgid "4K (2160p)"
msgstr "4K (2160p)"

msgctxt "#30015"
msgid "Full HD (1080p)"
msgstr "全高清 (1080p)"

msgctxt "#30016"
msgid "HD (720p)"
msgstr "高清 (720p)"

msgctxt "#30017"
msgid "Play HEVC (H.265)"
msgstr "播放 HEVC (H.265)"

msgctxt "#30018"
msgid "Turn off if HEVC video stutters on this device. The server then converts it to H.264."
msgstr "如果 HEVC 视频在此设备上卡顿，请关闭此项。服务器会将其转换为 H.264。"

msgctxt "#30019"
msgid "Play AV1"
msgstr "播放 AV1"

msgctxt "#30020"
msgid "Turn off if AV1 video stutters on this device (older hardware decodes it in software)."
msgstr "如果 AV1 视频在此设备上卡顿，请关闭此项（较旧的硬件以软件解码）。"

msgctxt "#30021"
msgid "Play VP9"
msgstr "播放 VP9"

msgctxt "#30022"
msgid "Turn off if VP9 video stutters on this device."
msgstr "如果 VP9 视频在此设备上卡顿，请关闭此项。"

msgctxt "#30023"
msgid "HDR"
msgstr "HDR"

msgctxt "#30024"
msgid "HDR video"
msgstr "HDR 视频"

msgctxt "#30025"
msgid "Automatic plays HDR as HDR when the display takes it and asks the server to convert it to SDR otherwise."
msgstr "“自动”会在显示器支持时以 HDR 播放 HDR，否则请服务器将其转换为 SDR。"

msgctxt "#30026"
msgid "Automatic (follow the display)"
msgstr "自动（跟随显示器）"

msgctxt "#30027"
msgid "Play as HDR (Kodi converts it if needed)"
msgstr "以 HDR 播放（必要时由 Kodi 转换）"

msgctxt "#30028"
msgid "Have the server convert it to SDR"
msgstr "由服务器转换为 SDR"

msgctxt "#30029"
msgid "Dolby Vision"
msgstr "Dolby Vision"

msgctxt "#30030"
msgid "Automatic plays Dolby Vision when the display takes it."
msgstr "“自动”会在显示器支持时播放 Dolby Vision。"

msgctxt "#30031"
msgid "Off"
msgstr "关闭"

msgctxt "#30032"
msgid "Versions"
msgstr "版本"

msgctxt "#30033"
msgid "Ask which version to play when there are several"
msgstr "有多个版本时询问要播放哪个"

msgctxt "#30034"
msgid "Otherwise the best version plays. Play version… in the context menu always asks."
msgstr "否则播放最佳版本。上下文菜单中的“播放版本…”总会询问。"

msgctxt "#30040"
msgid "Advanced"
msgstr "高级"

msgctxt "#30041"
msgid "Items per page"
msgstr "每页项目数"

msgctxt "#30042"
msgid "How many titles a library page lists before Next page."
msgstr "媒体库每页在“下一页”之前列出的标题数。"

msgctxt "#30043"
msgid "Load artwork through a local proxy"
msgstr "通过本地代理加载图片"

msgctxt "#30044"
msgid "Keeps poster addresses the same from day to day, so Kodi downloads each image once. Turn off only if the proxy can't start."
msgstr "让海报地址每天保持不变，使 Kodi 每张图片只下载一次。仅在代理无法启动时关闭。"

msgctxt "#30045"
msgid "Proxy port"
msgstr "代理端口"

msgctxt "#30046"
msgid "The local port the artwork proxy listens on (127.0.0.1 only). Changing it makes Kodi download the artwork again."
msgstr "图片代理监听的本地端口（仅限 127.0.0.1）。更改后 Kodi 会重新下载图片。"

msgctxt "#30100"
msgid "Continue Watching"
msgstr "继续观看"

msgctxt "#30101"
msgid "Next Up"
msgstr "接下来"

msgctxt "#30102"
msgid "Recently Added"
msgstr "最近添加"

msgctxt "#30103"
msgid "Plan to Watch"
msgstr "计划观看"

msgctxt "#30104"
msgid "Trending this week"
msgstr "本周热门"

msgctxt "#30105"
msgid "Libraries"
msgstr "媒体库"

msgctxt "#30106"
msgid "Watchlist"
msgstr "待看清单"

msgctxt "#30107"
msgid "Favorites"
msgstr "收藏"

msgctxt "#30108"
msgid "Search"
msgstr "搜索"

msgctxt "#30109"
msgid "Settings"
msgstr "设置"

msgctxt "#30110"
msgid "Next page ({shown} of {total})"
msgstr "下一页（{shown} / {total}）"

msgctxt "#30111"
msgid "Signed in as {user}"
msgstr "已登录为 {user}"

msgctxt "#30112"
msgid "Not signed in"
msgstr "未登录"

msgctxt "#30113"
msgid "Collections"
msgstr "合集"

msgctxt "#30114"
msgid "Play"
msgstr "播放"

msgctxt "#30115"
msgid "All"
msgstr "全部"

msgctxt "#30116"
msgid "Unwatched"
msgstr "未观看"

msgctxt "#30117"
msgid "In progress"
msgstr "观看中"

msgctxt "#30118"
msgid "Recently added"
msgstr "最近添加"

msgctxt "#30119"
msgid "Albums"
msgstr "专辑"

msgctxt "#30120"
msgid "Season {n}"
msgstr "第 {n} 季"

msgctxt "#30121"
msgid "Specials"
msgstr "特别篇"

msgctxt "#30122"
msgid "Episode {n}"
msgstr "第 {n} 集"

msgctxt "#30123"
msgid "Version {n}"
msgstr "版本 {n}"

msgctxt "#30124"
msgid "{version} · {count} parts"
msgstr "{version} · {count} 个部分"

msgctxt "#30125"
msgid "Choose a version"
msgstr "选择版本"

msgctxt "#30126"
msgid "Books"
msgstr "图书"

msgctxt "#30130"
msgid "Play version…"
msgstr "播放版本…"

msgctxt "#30131"
msgid "Mark watched"
msgstr "标记为已看"

msgctxt "#30132"
msgid "Mark unwatched"
msgstr "标记为未看"

msgctxt "#30133"
msgid "Add to Watchlist"
msgstr "添加到待看清单"

msgctxt "#30134"
msgid "Remove from Watchlist"
msgstr "从待看清单中移除"

msgctxt "#30135"
msgid "Add to favorites"
msgstr "添加到收藏"

msgctxt "#30136"
msgid "Remove from favorites"
msgstr "从收藏中移除"

msgctxt "#30137"
msgid "Remove from Continue Watching"
msgstr "从“继续观看”中移除"

msgctxt "#30138"
msgid "Go to show"
msgstr "前往剧集"

msgctxt "#30140"
msgid "Resume from {time}"
msgstr "从 {time} 继续播放"

msgctxt "#30141"
msgid "Play from the beginning"
msgstr "从头播放"

msgctxt "#30200"
msgid "Server address (e.g. http://192.168.1.10:7070)"
msgstr "服务器地址（例如 http://192.168.1.10:7070）"

msgctxt "#30201"
msgid "Couldn't reach {url}: {reason}"
msgstr "无法连接到 {url}：{reason}"

msgctxt "#30202"
msgid "{url} answered, but it isn't an OnScreen server."
msgstr "{url} 有响应，但它不是 OnScreen 服务器。"

msgctxt "#30203"
msgid "Sign in to OnScreen"
msgstr "登录 OnScreen"

msgctxt "#30204"
msgid "On a phone or computer, open"
msgstr "请在手机或电脑上打开"

msgctxt "#30205"
msgid "and enter the PIN"
msgstr "并输入 PIN 码"

msgctxt "#30206"
msgid "The PIN expired. Getting a new one…"
msgstr "PIN 码已过期。正在获取新的…"

msgctxt "#30207"
msgid "Couldn't start pairing: {reason}"
msgstr "无法开始配对：{reason}"

msgctxt "#30208"
msgid "How do you want to sign in?"
msgstr "你想如何登录？"

msgctxt "#30209"
msgid "With a PIN from a phone or computer (single sign-on too)"
msgstr "使用手机或电脑上的 PIN 码（也支持单点登录）"

msgctxt "#30210"
msgid "With a username and password"
msgstr "使用用户名和密码"

msgctxt "#30211"
msgid "Username"
msgstr "用户名"

msgctxt "#30212"
msgid "Password"
msgstr "密码"

msgctxt "#30213"
msgid "Two-factor code (or a recovery code)"
msgstr "两步验证码（或恢复码）"

msgctxt "#30214"
msgid "Sign-in failed: {reason}"
msgstr "登录失败：{reason}"

msgctxt "#30215"
msgid "Signed in as {user}"
msgstr "已登录为 {user}"

msgctxt "#30216"
msgid "Signed out"
msgstr "已退出登录"

msgctxt "#30217"
msgid "Sign {user} out on this device?"
msgstr "要在此设备上退出 {user} 的登录吗？"

msgctxt "#30218"
msgid "Your sign-in has expired. Sign in again."
msgstr "你的登录已过期。请重新登录。"

msgctxt "#30300"
msgid "Too many streams"
msgstr "播放流过多"

msgctxt "#30301"
msgid "Your account is already playing as many streams as it may. Stop one and try again."
msgstr "你的账户正在播放的串流已达上限。请停止其中一个后再试。"

msgctxt "#30302"
msgid "An administrator stopped this stream: {message}"
msgstr "管理员停止了此串流：{message}"

msgctxt "#30303"
msgid "An administrator stopped this stream."
msgstr "管理员停止了此串流。"

msgctxt "#30304"
msgid "Watch limit reached"
msgstr "已达到观看限制"

msgctxt "#30305"
msgid "Playback is outside the allowed hours set for this account. Try again during the permitted times."
msgstr "当前不在此账户允许的观看时段内。请在允许的时间内再试。"

msgctxt "#30306"
msgid "This account has used up today's watch time."
msgstr "此账户今天的观看时长已用完。"

msgctxt "#30307"
msgid "Playback is blocked by a parental watch limit on this account."
msgstr "此账户的家长观看限制阻止了播放。"

msgctxt "#30308"
msgid "Dolby Vision is not supported: this video can't play on this device, and the server can't convert it."
msgstr "不支持 Dolby Vision：此视频无法在此设备上播放，服务器也无法转换。"

msgctxt "#30309"
msgid "This file appears to be damaged, so it can't be played."
msgstr "此文件似乎已损坏，无法播放。"

msgctxt "#30310"
msgid "Couldn't start playback."
msgstr "无法开始播放。"

msgctxt "#30311"
msgid "This title has no playable files."
msgstr "此标题没有可播放的文件。"

msgctxt "#30312"
msgid "Starting…"
msgstr "正在启动…"

msgctxt "#30313"
msgid "Something went wrong."
msgstr "出错了。"

msgctxt "#30314"
msgid "Done"
msgstr "完成"

msgctxt "#30315"
msgid "Nothing here."
msgstr "这里什么都没有。"
