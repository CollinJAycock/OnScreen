msgstr "Reproducir con opciones…"

msgctxt "#30131"
msgid "Mark watched"
msgstr "Marcar como visto"

msgctxt "#30132"
msgid "Mark unwatched"
msgstr "Marcar como no visto"

msgctxt "#30133"
msgid "Add to Watchlist"
msgstr "Añadir a Mi lista"

msgctxt "#30134"
