msgctxt "#30153"
msgid "Now: {title} ({time})"
msgstr "Ahora: {title} ({time})"

msgctxt "#30154"
msgid "Next: {title} ({time})"
msgstr "A continuación: {title} ({time})"

msgctxt "#30155"
msgid "Scheduled"
msgstr "Programada"

