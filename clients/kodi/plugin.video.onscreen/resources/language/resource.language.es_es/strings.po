msgstr "Cancelada"

msgctxt "#30159"
msgid "Replaced by a newer recording"
msgstr "Sustituida por una grabación más reciente"

msgctxt "#30200"
msgid "Server address (e.g. http://192.168.1.10:7070)"
msgstr "Dirección del servidor (p. ej., http://192.168.1.10:7070)"

msgctxt "#30201"
msgid "Couldn't reach {url}: {reason}"
msgstr "No se pudo conectar con {url}: {reason}"

msgctxt "#30202"
msgid "{url} answered, but it isn't an OnScreen server."
msgstr "{url} respondió, pero no es un servidor OnScreen."

msgctxt "#30203"
msgid "Sign in to OnScreen"
msgstr "Iniciar sesión en OnScreen"

msgctxt "#30204"
msgid "On a phone or computer, open"
msgstr "En un teléfono o un ordenador, abre"

msgctxt "#30205"
msgid "and enter the PIN"
msgstr "y escribe el PIN"

msgctxt "#30206"
msgid "The PIN expired. Getting a new one…"
msgstr "El PIN ha caducado. Generando otro…"

msgctxt "#30207"
msgid "Couldn't start pairing: {reason}"
msgstr "No se pudo iniciar la vinculación: {reason}"

msgctxt "#30208"
msgid "How do you want to sign in?"
msgstr "¿Cómo quieres iniciar sesión?"

msgctxt "#30209"
msgid "With a PIN from a phone or computer (single sign-on too)"
msgstr "Con un PIN desde un teléfono o un ordenador (también inicio de sesión único)"

msgctxt "#30210"
msgid "With a username and password"
msgstr "Con usuario y contraseña"

msgctxt "#30211"
msgid "Username"
msgstr "Nombre de usuario"

msgctxt "#30212"
msgid "Password"
msgstr "Contraseña"

msgctxt "#30213"
msgid "Two-factor code (or a recovery code)"
msgstr "Código de verificación en dos pasos (o un código de recuperación)"

msgctxt "#30214"
msgid "Sign-in failed: {reason}"
msgstr "No se pudo iniciar sesión: {reason}"

msgctxt "#30215"
msgid "Signed in as {user}"
msgstr "Sesión iniciada como {user}"

msgctxt "#30216"
msgid "Signed out"
msgstr "Sesión cerrada"

msgctxt "#30217"
msgid "Sign {user} out on this device?"
msgstr "¿Cerrar la sesión de {user} en este dispositivo?"

msgctxt "#30218"
msgid "Your sign-in has expired. Sign in again."
msgstr "Tu sesión ha caducado. Vuelve a iniciar sesión."

msgctxt "#30300"
msgid "Too many streams"
msgstr "Demasiadas reproducciones"

msgctxt "#30301"
msgid "Your account is already playing as many streams as it may. Stop one and try again."
msgstr "Tu cuenta ya está reproduciendo todas las transmisiones que puede. Detén una y vuelve a intentarlo."

msgctxt "#30302"
msgid "An administrator stopped this stream: {message}"
msgstr "Un administrador detuvo esta reproducción: {message}"

msgctxt "#30303"
msgid "An administrator stopped this stream."
msgstr "Un administrador detuvo esta reproducción."

msgctxt "#30304"
msgid "Watch limit reached"
msgstr "Límite de visualización alcanzado"

msgctxt "#30305"
msgid "Playback is outside the allowed hours set for this account. Try again during the permitted times."
msgstr "La reproducción está fuera del horario permitido para esta cuenta. Inténtalo de nuevo en el horario permitido."

msgctxt "#30306"
msgid "This account has used up today's watch time."
msgstr "Esta cuenta ya ha agotado el tiempo de visualización de hoy."

msgctxt "#30307"
msgid "Playback is blocked by a parental watch limit on this account."
msgstr "La reproducción está bloqueada por un límite de control parental en esta cuenta."

msgctxt "#30308"
msgid "Dolby Vision is not supported: this video can't play on this device, and the server can't convert it."
msgstr "Dolby Vision no es compatible: este vídeo no se puede reproducir en este dispositivo y el servidor no puede convertirlo."

msgctxt "#30309"
msgid "This file appears to be damaged, so it can't be played."
msgstr "Este archivo parece estar dañado, así que no se puede reproducir."

msgctxt "#30310"
msgid "Couldn't start playback."
msgstr "No se pudo iniciar la reproducción."

msgctxt "#30311"
msgid "This title has no playable files."
msgstr "Este título no tiene archivos reproducibles."

msgctxt "#30312"
msgid "Starting…"
msgstr "Iniciando…"

msgctxt "#30313"
msgid "Something went wrong."
msgstr "Algo ha salido mal."

msgctxt "#30314"
msgid "Done"
msgstr "Hecho"

msgctxt "#30315"
msgid "Nothing here."
msgstr "No hay nada aquí."

msgctxt "#30316"
msgid "The server can't burn subtitles into the picture right now, so this plays without them."
msgstr "El servidor no puede incrustar subtítulos en la imagen ahora mismo, así que se reproduce sin ellos."

msgctxt "#30317"
msgid "Subtitles can't be burned into a movie in several parts, so this plays without them."
msgstr "No se pueden incrustar subtítulos en una película de varias partes, así que se reproduce sin ellos."

msgctxt "#30318"
msgid "Couldn't burn in that subtitle, so this plays without it."
msgstr "No se pudo incrustar ese subtítulo, así que se reproduce sin él."

msgctxt "#30319"
msgid "To seek in converted video, Kodi needs InputStream Adaptive. Install it when Kodi asks."
msgstr "Para avanzar o retroceder en un vídeo convertido, Kodi necesita InputStream Adaptive. Instálalo cuando Kodi lo pregunte."
