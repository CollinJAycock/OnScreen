<?xml version="1.0" encoding="utf-8"?>
<!-- The packages (UWP runtime, WinUI 2) come from nuget.org; a machine whose
     only source is Visual Studio's offline cache can't restore them. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
