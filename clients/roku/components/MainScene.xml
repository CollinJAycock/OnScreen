<?xml version="1.0" encoding="utf-8" ?>
<!--
    Root scene. Hosts a single child slot (`activeChild`) that swaps
    between the setup-flow and home-flow scenes. SceneGraph requires
    every channel to have exactly one root scene; everything else
    sits underneath it.

    The decision of which child to mount on launch lives in
    MainScene.brs (init handler) — checks Prefs.brs for stored URL +
    token and routes to ServerSetupScene / LoginScene / HomeScene
    accordingly.
-->
<component name="MainScene" extends="Scene">

    <interface>
        <!-- A deep link (Roku certification): source/main.brs sets the
             launch args or an roInputEvent's info here ({ contentId,
             mediaType }). See onDeepLink. -->
        <field id="deepLink" type="assocarray" onChange="onDeepLink" />

        <!-- Called by the child scenes via callFunc, which only reaches
             functions declared here. -->
        <function name="navigateTo" />
        <function name="navigateToWithItem" />
        <function name="navigateToWithParams" />
        <function name="runDetachedCall" />
        <!-- main.brs, once launch args are in: the first routing. -->
        <function name="start" />
        <!-- A scene the user can use is on screen (AppLaunchComplete). -->
        <function name="reportReady" />
    </interface>

    <script type="text/brightscript" uri="MainScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/Prefs.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/DeepLink.brs" />

    <children>
        <!-- Container the .brs swaps fragment scenes in/out of.
             Sized to fill the screen — child scenes own their
             own layout. -->
        <Group id="content"
               translation="[0,0]" />

        <!-- Parent for runDetachedCall's ApiCallTasks, so a request a
             scene fires on its way out isn't torn down with it. -->
        <Group id="detached" visible="false" />
    </children>

</component>
