<?xml version="1.0" encoding="utf-8" ?>
<!--
    Sign in. A column of buttons: Username, Password and Sign in first
    (Roku certification 2.2 wants sign-in on the device), then Sign in
    with another device (a PIN paired from a phone or computer, which
    also covers OIDC / SAML / LDAP) and Change server. One keyboard
    below them opens while a field is edited (LoginScene.brs).
    On success the tokens go to Prefs and the router moves to HomeScene.
-->
<component name="LoginScene" extends="Group">
    <interface>
        <!-- The node MainScene focuses once this scene is attached (mountScene):
             a setFocus in init() runs before the scene is in the tree. -->
        <field id="initialFocus" type="node" />
    </interface>


    <script type="text/brightscript" uri="LoginScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/Prefs.brs" />
    <script type="text/brightscript" uri="pkg:/source/api/Client.brs" />
    <script type="text/brightscript" uri="pkg:/source/api/Endpoints.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/Json.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x000000ff" />
        <Label id="title"
               translation="[160, 100]"
               font="font:LargeBoldSystemFont"
               color="0xffffffff" />
        <OsButton id="usernameBtn"
                translation="[160, 200]"
                minWidth="720" />
        <OsButton id="passwordBtn"
                translation="[160, 280]"
                minWidth="720" />
        <OsButton id="signInBtn"
                translation="[160, 360]"
                minWidth="720" />
        <Label id="orLabel"
               translation="[160, 450]"
               color="0xa0a0a0ff" />
        <OsButton id="pairBtn"
                translation="[160, 500]"
                minWidth="720" />
        <OsButton id="changeServerBtn"
                translation="[160, 580]"
                minWidth="720" />
        <!-- Two-factor step: replaces the password rows once /auth/login
             reports totp_required. -->
        <OsButton id="totpBtn"
                translation="[160, 200]"
                minWidth="720"
                visible="false" />
        <OsButton id="verifyBtn"
                translation="[160, 280]"
                minWidth="720"
                visible="false" />
        <Label id="error"
               translation="[960, 200]"
               width="800"
               wrap="true"
               color="0xff5050ff"
               visible="false" />
        <!-- The one keyboard, for whichever field is being edited. -->
        <!-- DynamicKeyboard: Roku's voice-capable keyboard, which
             certification requires for password and code entry. -->
        <DynamicKeyboard id="keyboard"
                         translation="[160, 596]"
                         visible="false" />
    </children>

</component>
