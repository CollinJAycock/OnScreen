<?xml version="1.0" encoding="utf-8" ?>
<!--
    Browse one library. Receives `itemId` (the library_id — same
    field MainScene.navigateToWithItem populates for every
    item-aware scene) and renders the library's items as a single
    poster row. Mirrors FavoritesScene's RowList shape so the
    PosterCard reuse and focus feel are identical.

    P0 ships a flat single-row grid; pagination + filter chips
    (movie/show/track type within mixed-type libraries — rare but
    possible via custom server config) are tracked on roku/todo.md
    and slot in here once the catalog grows past the 200-row
    over-fetch ceiling baked into ApiLibraryItems.
-->
<component name="LibraryScene" extends="Group">

    <interface>
        <field id="itemId" type="string" />
        <!-- The library's name for the heading (from the Libraries list). -->
        <field id="heading" type="string" onChange="onHeading" />
        <!-- The library's kind (movie, show, home_video, ...): its default
             sort and whether watch / genre filters apply. -->
        <field id="libraryType" type="string" />
        <!-- Where the viewer is, saved by MainScene on leaving (focusState)
             and handed back on Back (restoreState). -->
        <field id="focusState" type="assocArray" />
        <field id="restoreState" type="assocArray" />
    </interface>

    <script type="text/brightscript" uri="LibraryScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/Prefs.brs" />
    <script type="text/brightscript" uri="pkg:/source/api/Endpoints.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/WatchState.brs" />
    <script type="text/brightscript" uri="pkg:/components/common/CardFields.brs" />
    <script type="text/brightscript" uri="pkg:/components/common/MenuDialog.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/LibraryView.brs" />

    <children>
        <Group translation="[0,0]">
            <Rectangle width="1920" height="1080" color="0x121212ff" />

            <!-- Sort and filters, right of the heading; Up from the
                 grid's first row reaches them, Down goes back. -->
            <LayoutGroup id="viewButtons"
                         translation="[1840, 52]"
                         layoutDirection="horiz"
                         horizAlignment="right"
                         itemSpacings="[16]">
                <OsButton id="sortBtn" size="small" height="56" />
                <OsButton id="watchBtn" size="small" height="56" />
                <OsButton id="genreBtn" size="small" height="56" />
            </LayoutGroup>

            <Label id="title"
                   text="Library"
                   width="880"
                   translation="[80, 50]"
                   font="font:LargeBoldSystemFont"
                   color="0xffffffff" />

            <RowList id="rows"
                     translation="[80, 160]"
                     itemComponentName="PosterCard"
                     numRows="2"
                     itemSize="[1760, 430]"
                     itemSpacing="[0, 20]"
                     rowItemSize="[[240, 360]]"
                     rowItemSpacing="[[40, 0]]"
                     rowFocusAnimationStyle="floatingFocus"
                     showRowLabel="[false]"
                     rowHeights="[430]"
                     focusBitmapBlendColor="0xffffffff"
                     drawFocusFeedback="true" />

            <Label id="empty"
                   text="Loading..."
                   translation="[80, 540]"
                   color="0xa0a0a0ff" />
        </Group>

        <ListFetchTask id="task" />
    </children>

</component>
