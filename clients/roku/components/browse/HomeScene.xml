<?xml version="1.0" encoding="utf-8" ?>
<!--
    Top-level browse scene. Fires a Task node on mount to fetch
    /api/v1/hub, then populates a RowList with one row per hub
    section (Continue Watching TV / Movies / Other, Next Up, Plan to
    Watch, Trending, Recently Added). The * (options) key on a
    Continue Watching card offers "Remove from Continue Watching".

    RowList is SceneGraph's two-dimensional focus container —
    handles D-pad navigation between rows + within rows natively,
    binds to a ContentNode tree we build in BrightScript from the
    JSON response. Per-item visuals come from PosterCard.xml,
    referenced via itemComponentName.
-->
<component name="HomeScene" extends="Group">
    <interface>
        <!-- Where the viewer is, saved by MainScene on leaving (focusState)
             and handed back on Back (restoreState). -->
        <field id="focusState" type="assocArray" />
        <field id="restoreState" type="assocArray" />
    </interface>

    <script type="text/brightscript" uri="HomeScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/Prefs.brs" />
    <script type="text/brightscript" uri="pkg:/source/api/Endpoints.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/WatchState.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/HubRows.brs" />
    <script type="text/brightscript" uri="pkg:/components/common/CardFields.brs" />
    <script type="text/brightscript" uri="pkg:/components/common/MenuDialog.brs" />

    <children>
        <Group translation="[0,0]">
            <Rectangle width="1920" height="1080" color="0x121212ff" />

            <Label id="title"
                   text="OnScreen"
                   translation="[80, 50]"
                   font="font:LargeBoldSystemFont"
                   color="0xffffffff" />

            <!-- Header navigation buttons. Roku has no dedicated
                 search key on most remotes, so search + favorites
                 + watchlist + history live as Buttons in the
                 top-right of the hub. Same affordance the Android
                 client exposes via its bottom nav row. -->
            <LayoutGroup id="nav"
                         translation="[1840, 44]"
                         layoutDirection="horiz"
                         horizAlignment="right"
                         itemSpacings="[14]">
                <OsButton id="librariesBtn" text="Libraries" size="small" height="56" />
                <OsButton id="favoritesBtn" text="Favorites" size="small" height="56" />
                <OsButton id="watchlistBtn" text="Watchlist" size="small" height="56" />
                <OsButton id="historyBtn" text="History" size="small" height="56" />
                <OsButton id="searchBtn" text="Search" size="small" height="56" />
                <OsButton id="settingsBtn" text="Settings" size="small" height="56" />
            </LayoutGroup>
            <RowList id="rows"
                     translation="[80, 170]"
                     itemComponentName="PosterCard"
                     numRows="3"
                     itemSize="[1760, 430]"
                     itemSpacing="[0, 50]"
                     rowItemSize="[[240, 360]]"
                     rowItemSpacing="[[24, 0]]"
                     showRowLabel="[true]"
                     rowLabelOffset="[[0, 14]]"
                     rowLabelFont="font:MediumBoldSystemFont"
                     rowLabelColor="0xE8E8EEFF"
                     rowHeights="[430]"
                     drawFocusFeedback="true" />

            <Label id="loading"
                   text="Loading..."
                   translation="[80, 540]"
                   color="0xa0a0a0ff" />

            <!-- Shown while a Continue Watching card has focus. -->
            <Label id="optionsHint"
                   text="* Options"
                   translation="[1600, 1030]"
                   width="240"
                   horizAlign="right"
                   font="font:SmallSystemFont"
                   color="0x9a9aaaff"
                   visible="false" />
        </Group>

        <!-- Off-screen task that fetches the hub on its own
             thread (SceneGraph render thread can't block on
             network). HomeScene observes state="done" on it,
             then reads `result` for the parsed envelope. -->
        <HubFetchTask id="hubTask" />
        <!-- The saved row order (hub_layout), fetched beside the hub. -->
        <PreferencesFetchTask id="prefsTask" />
    </children>

</component>
