<?xml version="1.0" encoding="utf-8" ?>
<!--
    Item detail screen. Caller (HomeScene / SearchScene / future
    FavoritesScene) sets `itemId` on the node before mount, then
    calls navigateToWithItem("DetailScene", id) to attach. On init
    we fire two parallel tasks (item metadata + children list) and
    render a hero + action buttons + a horizontal child list.

    Layout follows the modern Android detail page:
      - full-bleed fanart (alpha-blended via a dimmer rectangle so
        the foreground content reads against any image)
      - title + meta line (year · rating · duration · genres)
      - summary
      - action buttons, left / right between them (Play focused on
        mount):
          Play       "Resume 12m" on a part-watched leaf; on a show or
                     season it comes from GET /items/{id}/up-next:
                     "Resume S3 · E4" / "Play S3 · E5" / "Watch again"
          Version    "Version: Director's Cut" when the item has two or
                     more versions (editions, a multi-part movie counts
                     as one); OK picks the one Play starts
          Mark       "Mark watched" / "Mark unwatched" (movies,
                     episodes); "Mark all…" on shows and seasons
                     (confirmation before unwatching a whole show)
          Instant mix  artists and albums: GET /music/mix?seed= played
                     as a queue
          Report     "Report a problem" (movies, episodes, shows)
      - children rows, down from the buttons: seasons / episodes /
        tracks / chapters / albums, with watched checks and resume
        bars. * on an episode or season card opens its options (mark
        watched / unwatched, report a problem). An artist adds
        "Similar artists" and "Appears on" rows below its albums; the
        list shows one row at a time and the header names the focused
        row.

    Episode-style children include the index ("1. Pilot") so the
    user knows order at a glance; album / podcast children use the
    plain title.
-->
<component name="DetailScene" extends="Group">

    <interface>
        <field id="itemId" type="string" />
    </interface>

    <script type="text/brightscript" uri="DetailScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/Prefs.brs" />
    <script type="text/brightscript" uri="pkg:/source/api/Endpoints.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/WatchState.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/DetailMeta.brs" />
    <script type="text/brightscript" uri="pkg:/source/playback/Versions.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/Music.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/ReportProblem.brs" />
    <script type="text/brightscript" uri="pkg:/components/common/CardFields.brs" />
    <script type="text/brightscript" uri="pkg:/components/common/MenuDialog.brs" />

    <children>
        <Group translation="[0,0]" width="1920" height="1080">
            <Rectangle width="1920" height="1080" color="0x07070dff" />

            <!-- Fanart fills the screen behind everything; dimmer
                 rectangle on top so the title + summary render
                 readably regardless of image content. -->
            <!-- loadWidth/loadHeight cap the decode at screen size so
                 oversized source fanart can't OOM low-RAM devices. -->
            <Poster id="fanart"
                    width="1920" height="1080"
                    loadWidth="1920" loadHeight="1080"
                    loadDisplayMode="scaleToFill"
                    loadingBitmapOpacity="0" />
            <Rectangle width="1920" height="1080" color="0x07070dcc" />

            <!-- Content column. -->
            <Group translation="[80, 260]">
                <!-- Clear logo (logo_path, movies + shows): a transparent
                     PNG shown in place of the title text once it loads.
                     Hidden until then, so a missing / failed logo leaves
                     the title as it was. DetailScene.brs sizes it to the
                     bitmap, left-aligned, bottom just above the meta line. -->
                <Poster id="logo"
                        width="640" height="170"
                        loadWidth="640" loadHeight="170"
                        loadDisplayMode="scaleToFit"
                        loadingBitmapOpacity="0"
                        failedBitmapOpacity="0"
                        visible="false" />
                <Label id="title"
                       text=""
                       font="font:LargeBoldSystemFont"
                       color="0xffffffff" />
                <Label id="meta"
                       text=""
                       translation="[0, 80]"
                       color="0x9a9aaaff" />
                <Label id="summary"
                       text=""
                       translation="[0, 130]"
                       width="1200"
                       wrap="true"
                       maxLines="4"
                       color="0xeeeef8ff" />
            </Group>

            <!-- Action buttons. Fixed widths so DetailScene.brs can lay
                 the visible ones out left to right (hidden ones leave
                 no gap). -->
            <Group id="actions" translation="[80, 580]">
                <Button id="playBtn"
                        text="Play"
                        showFocusFootprint="true"
                        minWidth="400"
                        maxWidth="400"
                        focusBitmapBlendColor="0x7c6af7ff" />
                <Button id="versionBtn"
                        text=""
                        showFocusFootprint="true"
                        minWidth="480"
                        maxWidth="480"
                        focusBitmapBlendColor="0x7c6af7ff"
                        visible="false" />
                <Button id="mixBtn"
                        text="Instant mix"
                        showFocusFootprint="true"
                        minWidth="360"
                        maxWidth="360"
                        focusBitmapBlendColor="0x7c6af7ff"
                        visible="false" />
                <Button id="markBtn"
                        text=""
                        showFocusFootprint="true"
                        minWidth="360"
                        maxWidth="360"
                        focusBitmapBlendColor="0x7c6af7ff"
                        visible="false" />
                <Button id="reportBtn"
                        text="Report a problem"
                        showFocusFootprint="true"
                        minWidth="360"
                        maxWidth="360"
                        focusBitmapBlendColor="0x7c6af7ff"
                        visible="false" />
            </Group>

            <!-- Children carousel (episodes / tracks / chapters), plus
                 an artist's Similar artists / Appears on rows. Hidden
                 until a fetch lands with at least one item. Item size is
                 set per parent type in renderChildren (landscape for
                 episodes). One row on screen at a time (numRows 1,
                 floating focus: no wrap, up from the first row bubbles
                 to the buttons); childrenHeader names the focused row. -->
            <Label id="childrenHeader"
                   text=""
                   translation="[80, 690]"
                   font="font:MediumBoldSystemFont"
                   color="0xffffffff"
                   visible="false" />
            <RowList id="children"
                     translation="[80, 740]"
                     itemComponentName="PosterCard"
                     itemSize="[1760, 300]"
                     rowItemSize="[[200, 260]]"
                     rowItemSpacing="[[16, 0]]"
                     showRowLabel="[false]"
                     rowHeights="[300]"
                     numRows="1"
                     vertFocusAnimationStyle="floatingFocus"
                     focusBitmapBlendColor="0xffffffff"
                     drawFocusFeedback="true"
                     visible="false" />

            <!-- Shown while an episode / season card with options has
                 focus. -->
            <Label id="optionsHint"
                   text="* Options"
                   translation="[1600, 1030]"
                   width="240"
                   horizAlign="right"
                   font="font:SmallSystemFont"
                   color="0x9a9aaaff"
                   visible="false" />

            <Label id="loading"
                   text="Loading…"
                   translation="[80, 540]"
                   color="0xa0a0a0ff" />
        </Group>

        <ItemFetchTask id="itemTask" />
        <ChildrenFetchTask id="childrenTask" />
    </children>

</component>
