<?xml version="1.0" encoding="utf-8" ?>
<!--
    Revokes the stored session on its server (Client_LogoutSync: refresh,
    then POST /auth/logout with the refresh token) and clears the tokens.
    A Task because roUrlTransfer can't be created on the render thread.
    LoginScene's Change server runs it and waits for state "done".
-->
<component name="LogoutTask" extends="Task">
    <script type="text/brightscript" uri="LogoutTask.brs" />
    <script type="text/brightscript" uri="pkg:/source/api/Client.brs" />
    <script type="text/brightscript" uri="pkg:/source/api/Endpoints.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/Json.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/Prefs.brs" />
</component>
