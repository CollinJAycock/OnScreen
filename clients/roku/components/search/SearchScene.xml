<?xml version="1.0" encoding="utf-8" ?>
<!--
    Search screen — TV equivalent of the web /search page.

    Layout (top to bottom):
      - Title
      - Filter chips: Movies / TV Shows / Episodes / Tracks. Movies
        + TV Shows on by default; episodes + tracks default off so
        a search for "Dream" doesn't bury three movie matches under
        fifty Pink Floyd track names. Filter state is persisted to
        the registry under the same conceptual key the web client
        uses (onscreen_search_filters). Toggling a chip re-applies
        the type filter to the existing result set without re-
        issuing the network call.
      - Inline keyboard
      - Result grid (RowList, single row)

    The search itself fires after a debounce window — Roku
    keyboards emit a `text` change on every keystroke, which would
    flood the API otherwise.
-->
<component name="SearchScene" extends="Group">
    <interface>
        <!-- The node MainScene focuses once this scene is attached (mountScene):
             a setFocus in init() runs before the scene is in the tree. -->
        <field id="initialFocus" type="node" />
        <!-- Where the viewer is, saved by MainScene on leaving (focusState)
             and handed back on Back (restoreState). -->
        <field id="focusState" type="assocArray" />
        <field id="restoreState" type="assocArray" />
    </interface>


    <script type="text/brightscript" uri="SearchScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/Prefs.brs" />
    <script type="text/brightscript" uri="pkg:/source/api/Endpoints.brs" />
    <script type="text/brightscript" uri="pkg:/components/common/MenuDialog.brs" />

    <children>
        <Group translation="[0,0]">
            <Rectangle width="1920" height="1080" color="0x121212ff" />

            <Label id="title"
                   translation="[80, 50]"
                   font="font:LargeBoldSystemFont"
                   color="0xffffffff" />

            <!-- Search in: all libraries or one (the server's library_id),
                 as Android TV's scope chip. Up from the chips. -->
            <OsButton id="scopeBtn"
                      translation="[740, 58]"
                      size="small"
                      height="56" />

            <!-- Left column: filter chips, then the keyboard. Right column:
                 the results grid. Keys: SearchScene.brs onKeyEvent. -->
            <LayoutGroup id="chipRow"
                         translation="[80, 140]"
                         layoutDirection="horiz"
                         itemSpacings="[12]">
                <OsButton id="chipMovie" size="small" height="56" />
                <OsButton id="chipShow" size="small" height="56" />
                <OsButton id="chipEpisode" size="small" height="56" />
                <OsButton id="chipTrack" size="small" height="56" />
            </LayoutGroup>
            <Label id="typeHint" translation="[80, 230]" color="0xa0a0a0ff" />
            <MiniKeyboard id="queryField"
                          translation="[80, 270]" />
            <RowList id="results"
                     translation="[740, 230]"
                     itemComponentName="PosterCard"
                     numRows="2"
                     itemSize="[1100, 400]"
                     itemSpacing="[0, 20]"
                     rowItemSize="[[200, 300]]"
                     rowItemSpacing="[[22, 0]]"
                     rowFocusAnimationStyle="floatingFocus"
                     showRowLabel="[false]"
                     rowHeights="[400]"
                     drawFocusFeedback="true"
                     visible="false" />
            <Label id="status"
                   translation="[740, 270]"
                   width="1100"
                   wrap="true"
                   color="0xa0a0a0ff" />
        </Group>

        <SearchTask id="searchTask" />
    </children>

</component>
