<?xml version="1.0" encoding="utf-8" ?>
<!--
    Settings, from Home's header. Account: who is signed in, the server,
    Sign out (keeps the server) and Forget server (back to setup), both
    confirmed first. About: version, the privacy policy address and the
    source. Language: the interface language (Device language / English /
    Español), switched at once and saved to the account. Playback (right):
    audio and subtitle languages, forced subtitles only, the quality
    limits, and the rating ceiling an admin set (read-only). Mirrors the TV
    web app's Settings sections.
-->
<component name="SettingsScene" extends="Group">
    <interface>
        <field id="initialFocus" type="node" />
        <!-- MainScene mounts Settings again after a language change and
             hands back focusState as restoreState ({ focus: "language" }). -->
        <field id="focusState" type="assocArray" />
        <field id="restoreState" type="assocArray" onChange="onRestoreState" />
        <!-- MainScene: how the language save went ("saved" / "failed"). -->
        <field id="languageSave" type="string" onChange="onLanguageSave" />
    </interface>
    <script type="text/brightscript" uri="SettingsScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/Prefs.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/Strings.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/SettingsPrefs.brs" />
    <script type="text/brightscript" uri="pkg:/source/api/Endpoints.brs" />
    <script type="text/brightscript" uri="pkg:/components/common/MenuDialog.brs" />
    <children>
        <Rectangle width="1920" height="1080" color="0x121212ff" />
        <Label id="heading"
               translation="[80, 50]"
               font="font:LargeBoldSystemFont"
               color="0xffffffff" />

        <Label id="accountHeading"
               translation="[80, 170]"
               font="font:MediumBoldSystemFont"
               color="0xE8E8EEFF" />
        <Label id="userLine"
               translation="[80, 225]"
               color="0xC8C8D0FF" />
        <Label id="serverLine"
               translation="[80, 270]"
               width="840"
               color="0xC8C8D0FF" />
        <Label id="insecureLine"
               translation="[80, 315]"
               width="840"
               color="0xF0B860FF"
               visible="false" />
        <LayoutGroup id="accountButtons"
                     translation="[80, 370]"
                     layoutDirection="horiz"
                     itemSpacings="[20]">
            <OsButton id="signOutBtn" minWidth="260" />
            <OsButton id="forgetBtn" minWidth="260" />
        </LayoutGroup>
        <Label id="accountHelp"
               translation="[80, 460]"
               width="840"
               wrap="true"
               font="font:SmallSystemFont"
               color="0x9A9AAAFF" />

        <Label id="aboutHeading"
               translation="[80, 640]"
               font="font:MediumBoldSystemFont"
               color="0xE8E8EEFF" />
        <Label id="versionLine"
               translation="[80, 695]"
               color="0xC8C8D0FF" />
        <Label id="privacyLine"
               translation="[80, 740]"
               color="0xC8C8D0FF" />
        <Label id="sourceLine"
               translation="[80, 785]"
               color="0xC8C8D0FF" />

        <!-- Language: one row like the Playback ones (OK moves it to the
             next choice), and a note when the account didn't take it. -->
        <Label id="languageHeading"
               translation="[80, 845]"
               font="font:MediumBoldSystemFont"
               color="0xE8E8EEFF" />
        <Group id="languageRow" translation="[80, 895]" />
        <Label id="languageNote"
               translation="[80, 973]"
               width="840"
               wrap="true"
               font="font:SmallSystemFont"
               color="0xF0B860FF"
               visible="false" />

        <!-- Playback: rows built by SettingsScene.brs (OK cycles a value,
             saved at once). -->
        <Label id="playbackHeading"
               translation="[1040, 170]"
               font="font:MediumBoldSystemFont"
               color="0xE8E8EEFF" />
        <Group id="playbackRows" translation="[1040, 225]" />
        <Label id="ratingLine"
               translation="[1040, 830]"
               width="800"
               wrap="true"
               font="font:SmallSystemFont"
               color="0x9A9AAAFF" />
        <PreferencesFetchTask id="prefsTask" />
    </children>
</component>
