{
  "name": "onscreen-webos",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 5174",
    "build": "vite build && node scripts/rewrite-file-paths.mjs && node scripts/assemble-package.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5174",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "package": "npm run build && ares-package build",
    "install-tv": "node scripts/install.mjs --tv",
    "launch-tv": "ares-launch --device tv tv.onscreen.webos",
    "inspect-tv": "ares-inspect --device tv --app tv.onscreen.webos",
    "install-emu": "node scripts/install.mjs --emu",
    "launch-emu": "ares-launch --device emulator tv.onscreen.webos",
    "inspect-emu": "ares-inspect --device emulator --app tv.onscreen.webos",
    "dev:emu": "npm run package && npm run install-emu && npm run launch-emu && npm run inspect-emu"
  },
  "dependencies": {
    "hls.js": "^1.7.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "playwright-core": "^1.65.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
