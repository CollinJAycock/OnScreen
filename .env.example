# OnScreen — bootstrap configuration
#
# Copy to .env, fill in the required values, then run the server.
#
# Anything that can be configured at runtime lives in the admin Settings UI at
# /settings — TMDB / TVDB keys, transcode tuning + output limits (max bitrate /
# width / height), scanner concurrency + missing-file grace period, OIDC, LDAP,
# OpenSubtitles, SMTP, webhooks, scheduled tasks, worker fleet, OpenTelemetry
# tracing, the public base URL, log level, and CORS allow-list.
#
# What remains here is the irreducible bootstrap set: things needed to open
# the database, bind HTTP listeners, or decrypt settings before the UI exists.

# ── Required ─────────────────────────────────────────────────────────────────
export DATABASE_URL="postgres://onscreen:onscreen@localhost:5432/onscreen?sslmode=disable"
export VALKEY_URL="redis://localhost:6379"
export SECRET_KEY="change-me-to-a-random-32-byte-string"  # AES-256: hex (64), base64 (~44), or raw 32+ bytes

# ── Node identity ────────────────────────────────────────────────────────────
# NODE_ID names this node so it can read its own row in the node_settings table
# (Settings ▸ Nodes — per-node config that must NOT be shared fleet-wide). Empty
# defaults to the host name. This is irreducible: a node must know who it is
# before it can look up its own config.
# export NODE_ID="node-a"
#
# Break-glass: boot from env/defaults only, ignoring the node_settings row. Use
# to recover a node locked out by a bad UI value (e.g. an unreachable LISTEN_ADDR).
# export IGNORE_NODE_DB_CONFIG="true"

# ── Bind addresses & infrastructure ──────────────────────────────────────────
# DATABASE_RO_URL must be set before the process can open a read-replica pool, so
# it stays env-only. The bind addresses and file paths below are the initial
# defaults — their effective values are editable per node in Settings ▸ Nodes
# (a saved value wins; set IGNORE_NODE_DB_CONFIG to fall back to these).
# export DATABASE_RO_URL="postgres://...@readonly:5432/onscreen?sslmode=disable"  # falls back to DATABASE_URL
# export LISTEN_ADDR=":7070"
# export METRICS_ADDR=":7071"
# export WORKER_HEALTH_ADDR=":7074"                        # worker binary only
#
# TLS: set both to serve HTTPS from files on disk (these win over an uploaded
# cert). Leave unset to manage the certificate in Settings ▸ System instead.
# export TLS_CERT_FILE="/etc/onscreen/tls/fullchain.pem"
# export TLS_KEY_FILE="/etc/onscreen/tls/privkey.pem"

# ── High availability & multi-site (all opt-in; off by default) ──────────────
# See docs/dr-runbook.md. A standard single-node install needs none of these.
#
# NOTE: the cluster-wide toggles below (PUBLIC_ASSET_CACHE, STATIC_ABR_ENABLED —
# plus server name, retention, TMDB rate limit, ABR) are now also editable in the
# admin UI under Settings ▸ System. The node/site-specific ones (STATIC_ABR_ROOT,
# SITE_ID) are editable per node under Settings ▸ Nodes. These env vars are the
# initial default; a saved UI value wins. Only connection strings, Sentinel, and
# AUTO_MIGRATE remain pure env — they're needed before the settings table is
# reachable (server_settings replicates across sites; node_settings is per-node).
#
# Postgres failover: a multi-host DATABASE_URL — pgx connects to whichever host
# is read-write and re-homes after a promotion (ADR-033).
# export DATABASE_URL="postgres://onscreen:pass@pg-primary:5432,pg-standby:5432/onscreen?target_session_attrs=read-write&sslmode=disable"
#
# Valkey Sentinel (HA lock/session/cache tier). VALKEY_URL still supplies auth/db.
# export VALKEY_SENTINEL_ADDRS="sentinel1:26379,sentinel2:26379,sentinel3:26379"
# export VALKEY_SENTINEL_MASTER="onscreen"
# export VALKEY_SENTINEL_PASSWORD=""
#
# Single-container deploys with no separate migrate step:
# export AUTO_MIGRATE="true"
#
# CDN: emit public cache headers on immutable app-served artwork (object-storage
# bytes already offload via signed URLs — Settings ▸ Storage).
# export PUBLIC_ASSET_CACHE="true"
#
# Static-ABR: pre-encode popular titles' ABR ladders to the media store.
# Worthwhile only with object storage + a CDN.
# export STATIC_ABR_ENABLED="true"
# export STATIC_ABR_ROOT=""                                 # empty = bucket-relative; a dir for a local static root
#
# Multi-site DR: name this site (shown at /health/cluster alongside DB role + lag).
# export SITE_ID="site-a"

# ── Development ──────────────────────────────────────────────────────────────
# export DEV_FRONTEND_URL="http://localhost:5173"          # proxy to Vite (dev builds only)
