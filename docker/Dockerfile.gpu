# GPU-enabled variant — uses pre-built onscreen-ffmpeg image with NVENC.
# Requires: NVIDIA Container Toolkit on the host, GPU passthrough enabled.
#
# Prerequisites (one-time):
#   docker build -f docker/Dockerfile.ffmpeg -t onscreen-ffmpeg:latest .
#
# Build:
#   docker build -f docker/Dockerfile.gpu -t onscreen:gpu .
#
# Run:
#   docker run --gpus all -e ... onscreen:gpu

# syntax=docker/dockerfile:1

# ── Stage 1: build frontend ───────────────────────────────────────────────────
FROM node:25-alpine AS frontend
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm install --no-audit --no-fund
COPY web/ ./
RUN npm run build

# ── Stage 2: build Go binaries ───────────────────────────────────────────────
# Use the minor-version tag (1.26-alpine) rather than a pinned patch so the
# image picks up patch releases that match go.mod's `go 1.26.x` directive
# without requiring a Dockerfile bump on every Go security release.
FROM golang:1.26-alpine AS builder
WORKDIR /app

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .
COPY --from=frontend /app/web/dist ./internal/webui/dist

ARG VERSION=dev
ARG BUILD_TIME
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    set -e && \
    CGO_ENABLED=0 GOOS=linux go build \
      -ldflags "-X main.version=${VERSION} -X main.buildTime=${BUILD_TIME}" \
      -o /bin/server ./cmd/server && \
    CGO_ENABLED=0 GOOS=linux go build \
      -ldflags "-X main.version=${VERSION} -X main.buildTime=${BUILD_TIME}" \
      -o /bin/worker ./cmd/worker && \
    CGO_ENABLED=0 GOOS=linux go install github.com/pressly/goose/v3/cmd/goose@v3.24.1 && \
    cp $(go env GOPATH)/bin/goose /bin/goose && \
    test -x /bin/server && test -x /bin/worker && test -x /bin/goose

# ── Stage 3: runtime (pre-built FFmpeg + Go binaries) ────────────────────────
FROM onscreen-ffmpeg:latest

# Non-root user. CACHE_PATH pinned to /var/cache/onscreen rather than the
# user's home — see the matching block in docker/Dockerfile for the
# rationale (alpine's adduser-S home behaviour drifted between releases
# and broke the artwork resize cache silently). The GPU image is debian-
# based via the nvidia/cuda upstream, but the same pin keeps the runtime
# state location consistent across both flavours.
RUN groupadd -r onscreen && useradd -r -g onscreen onscreen \
 && mkdir -p /var/cache/onscreen \
 && chown -R onscreen:onscreen /var/cache/onscreen
USER onscreen
ENV CACHE_PATH=/var/cache/onscreen
# CUDA JIT cache on the persistent, writable cache volume. ffmpeg ships its CUDA
# filters (scale_cuda) as PTX that the driver JIT-compiles to this GPU's SASS on
# first use — CPU-bound, ~90s cold on older arches. The default cache lives in
# $HOME/.nv, which the non-root onscreen user can't write, so without this it
# re-JITs on EVERY process (blowing the scale_cuda probe's timeout → cuda_scale
# disabled, and a ~90s stall at the head of every transcode). Pointing it at the
# /var/cache/onscreen volume makes the JIT a one-time cost that survives restarts.
ENV CUDA_CACHE_PATH=/var/cache/onscreen/nv

COPY --from=builder /bin/server  /usr/local/bin/server
COPY --from=builder /bin/worker  /usr/local/bin/worker
COPY --from=builder /bin/goose   /usr/local/bin/goose

COPY --chown=onscreen:onscreen internal/db/migrations /migrations

# NVIDIA runtime env — makes nvidia-smi and GPU visible inside the container.
# `graphics` is REQUIRED, not optional: nvidia-container-toolkit only injects
# the NVIDIA Vulkan ICD when `graphics` is among the requested capabilities,
# and the libplacebo (Vulkan) HDR→SDR tonemap — which also does the GPU-side
# downscale in the same pass — silently falls back to software zscale without
# it (observed on the RTX 5000 TrueNAS deploy: ProbeLibplaceboVulkan failed,
# 4K transcodes capped at ~0.5× real-time on the software scale). Use `all`
# so the Vulkan loader finds the ICD; see the matching note in Dockerfile.ffmpeg.
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=all

VOLUME /var/cache/onscreen
EXPOSE 7070 7071

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s \
  CMD wget -qO- http://localhost:7070/health/ready || exit 1

# Give the Go server enough time to drain connections and close DB pools.
# The server's internal shutdown timeout is 30 s; Docker's default is only 10 s.
STOPSIGNAL SIGTERM
LABEL com.docker.compose.stop-grace-period="35s"

ENTRYPOINT ["/usr/local/bin/server"]
