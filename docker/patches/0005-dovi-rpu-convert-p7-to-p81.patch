+static int dovi_rpu_filter(AVBSFContext *bsf, AVPacket *pkt)
+{
+    DoviRpuContext *s = bsf->priv_data;
+    if (s->passthrough)
+        return ff_bsf_get_packet_ref(bsf, pkt);
+    if (s->convert_active)
+        return dovi_rpu_filter_convert_p81(bsf, pkt);
+    return ff_cbs_bsf_generic_filter(bsf, pkt);
+}
