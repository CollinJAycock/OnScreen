+/* Size of the next NAL unit in an Annex B buffer: up to the next start
+ * code (00 00 01, its leading zero bytes excluded) or the end. */
+static int annexb_nal_end(const uint8_t *buf, int size)
+{
+    for (int i = 0; i + 2 < size; i++) {
+        if (buf[i] == 0 && buf[i + 1] == 0 && buf[i + 2] == 1) {
+            while (i > 0 && buf[i - 1] == 0)
+                i--;
+            return i;
+        }
+    }
+    return size;
+}
+
+/* Rewrites one profile 7 RPU NAL unit (2-byte header included) as a
+ * profile 8.1 one into *out: 7C 01 + escaped payload. 0 bytes when the RPU
+ * carries no mapping, or can't be parsed (a warning is logged and the frame
+ * goes out without one). */
+static int convert_rpu_nal(AVBSFContext *bsf, const AVPacket *pkt,
+                           const uint8_t *nal, int nal_size,
+                           uint8_t **out, int *out_size)
+{
+    DoviRpuContext *s = bsf->priv_data;
+    uint8_t *rpu = NULL, *dst;
+    int rpu_size, n = 0, zeros = 0, ret;
+
+    *out = NULL;
+    *out_size = 0;
+    av_fast_padded_malloc(&s->rbsp, &s->rbsp_size, nal_size);
+    if (!s->rbsp)
+        return AVERROR(ENOMEM);
+    /* Undo emulation prevention (00 00 03 -> 00 00) after the NAL header. */
+    for (int i = 2; i < nal_size; i++) {
+        if (zeros >= 2 && nal[i] == 3) {
+            zeros = 0;
+            continue;
+        }
+        zeros = nal[i] ? 0 : zeros + 1;
+        s->rbsp[n++] = nal[i];
+    }
+
+    ret = update_rpu(bsf, pkt, FF_DOVI_WRAP_NAL, s->rbsp, n, &rpu, &rpu_size);
+    if (ret < 0) {
+        av_log(bsf, AV_LOG_WARNING, "Dropping an RPU that could not be "
+               "converted to profile 8.1: %s\n", av_err2str(ret));
+        return 0;
+    }
+    if (!rpu || rpu_size <= 0) {
+        av_free(rpu);
+        return 0;
+    }
+
+    dst = av_malloc(rpu_size + 2);
+    if (!dst) {
+        av_free(rpu);
+        return AVERROR(ENOMEM);
+    }
+    dst[0] = nal[0];
+    dst[1] = nal[1];
+    memcpy(dst + 2, rpu, rpu_size);
+    av_free(rpu);
+    *out = dst;
+    *out_size = rpu_size + 2;
+    return 0;
+}
+
+/**
+ * convert_p81: walks the packet's NAL units in the format they came in
+ * (hvcC length-prefixed or Annex B) and writes them back in that format,
+ * every enhancement layer unit (type 63) dropped and the RPU (type 62)
+ * rewritten. Everything else, base layer parameter sets and slices
+ * included, is copied byte for byte, and the extradata is left alone. The
+ * CBS round trip the other modes use isn't used here: it writes Annex B,
+ * after which an MP4 muxer with an hvc1 tag moves every in-band parameter
+ * set into the sample entry, which breaks a base layer whose in-band sets
+ * differ from its hvcC ones.
+ */
+static int dovi_rpu_filter_convert_p81(AVBSFContext *bsf, AVPacket *pkt)
+{
+    DoviRpuContext *s = bsf->priv_data;
+    const int lsize = s->nal_length_size;
+    AVPacket *in = NULL;
+    uint8_t *out = NULL;
+    size_t out_size = 0, out_cap;
+    const uint8_t *buf, *end;
+    int ret;
+
+    ret = ff_bsf_get_packet(bsf, &in);
+    if (ret < 0)
+        return ret;
+
+    out_cap = in->size + 1024;
+    out = av_malloc(out_cap + AV_INPUT_BUFFER_PADDING_SIZE);
+    if (!out) {
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+
+    buf = in->data;
+    end = in->data + in->size;
+    while (buf < end) {
+        const uint8_t *nal, *prefix = buf;
+        int nal_size, prefix_size, type;
+        uint8_t *rpu = NULL;
+        int rpu_size = 0;
+
+        if (lsize) {
+            if (end - buf < lsize) {
+                ret = AVERROR_INVALIDDATA;
+                goto fail;
+            }
+            nal_size = 0;
+            for (int i = 0; i < lsize; i++)
+                nal_size = (nal_size << 8) | buf[i];
+            buf += lsize;
+            if (nal_size < 0 || nal_size > end - buf) {
+                ret = AVERROR_INVALIDDATA;
+                goto fail;
+            }
+        } else {
+            /* Skip to the start code, then past it. */
+            while (end - buf >= 3 && !(buf[0] == 0 && buf[1] == 0 && buf[2] == 1))
+                buf++;
+            if (end - buf < 3)
+                break;
+            buf += 3;
+            nal_size = annexb_nal_end(buf, end - buf);
+        }
+        prefix_size = buf - prefix;
+        nal = buf;
+        buf += nal_size;
+        if (nal_size < 2)
+            continue;
+
+        type = (nal[0] >> 1) & 0x3f;
+        if (type == HEVC_NAL_UNSPEC63)
+            continue;
+        if (type == HEVC_NAL_UNSPEC62) {
+            ret = convert_rpu_nal(bsf, in, nal, nal_size, &rpu, &rpu_size);
+            if (ret < 0)
+                goto fail;
+            if (!rpu_size)
+                continue;
+            nal = rpu;
+            nal_size = rpu_size;
+        }
+
+        if (out_size + 4 + nal_size > out_cap) {
+            out_cap = FFMAX(out_cap * 2, out_size + 4 + nal_size);
+            ret = av_reallocp(&out, out_cap + AV_INPUT_BUFFER_PADDING_SIZE);
+            if (ret < 0) {
+                av_free(rpu);
+                goto fail;
+            }
+        }
+        if (lsize) {
+            for (int i = lsize - 1; i >= 0; i--)
+                out[out_size++] = (nal_size >> (8 * i)) & 0xff;
+        } else {
+            /* Keep the 3- or 4-byte start code the unit had. */
+            if (prefix_size >= 4)
+                out[out_size++] = 0;
+            out[out_size++] = 0;
+            out[out_size++] = 0;
+            out[out_size++] = 1;
+        }
+        memcpy(out + out_size, nal, nal_size);
+        out_size += nal_size;
+        av_free(rpu);
+    }
+    memset(out + out_size, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+
+    ret = av_packet_from_data(pkt, out, out_size);
+    if (ret < 0)
+        goto fail;
+    out = NULL;
+    ret = av_packet_copy_props(pkt, in);
+    if (ret < 0) {
+        av_packet_unref(pkt);
+        goto fail;
+    }
+
+fail:
+    av_free(out);
+    av_packet_free(&in);
+    return ret;
+}
+
