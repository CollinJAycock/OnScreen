+/* The BT.2020 matrices profile 8.1 expects, as dovi_tool's mode 2 writes
+ * them (libdovi VdrDmData::set_p81_coeffs). */
+static const int p81_ycc_to_rgb[9] = {
+    9574, 0, 13802, 9574, -1540, -5348, 9574, 17610, 0,
+};
+static const unsigned p81_ycc_to_rgb_offset[3] = {
+    16777216, 134217728, 134217728,
+};
+static const int p81_rgb_to_lms[9] = {
+    7222, 8771, 390, 2654, 12430, 1300, 0, 422, 15962,
+};
+
+/* libdovi RpuDataNlq::is_mel(): every NLQ parameter is the identity. */
+static int dovi_nlq_is_mel(const AVDOVIRpuDataHeader *hdr,
+                           const AVDOVIDataMapping *mapping)
+{
+    const uint64_t one = 1ULL << hdr->coef_log2_denom;
+    for (int c = 0; c < 3; c++) {
+        const AVDOVINLQParams *nlq = &mapping->nlq[c];
+        if (nlq->nlq_offset || nlq->vdr_in_max != one ||
+            nlq->linear_deadzone_slope || nlq->linear_deadzone_threshold)
+            return 0;
+    }
+    return 1;
+}
+
+/**
+ * Profile 7 -> profile 8.1, as `dovi_tool -m 2 convert --discard` does it:
+ * the enhancement layer is dropped (see dovi_rpu_filter_convert_p81()), so
+ * the RPU stops describing one. Residual decoding is disabled and the NLQ
+ * parameters go. For a full enhancement layer (FEL) the BL->VDR reshaping is
+ * replaced by the identity, since it only made sense together with the FEL's
+ * residual; a minimal enhancement layer (MEL) keeps its mapping. When the
+ * frame carries display management data, its matrices become the BT.2020
+ * ones profile 8.1 expects.
+ */
+static void dovi_convert_to_p81(AVDOVIMetadata *metadata)
+{
+    AVDOVIRpuDataHeader *hdr = av_dovi_get_header(metadata);
+    AVDOVIDataMapping *mapping = av_dovi_get_mapping(metadata);
+    AVDOVIColorMetadata *color = av_dovi_get_color(metadata);
+    const int fel = mapping->nlq_method_idc != AV_DOVI_NLQ_NONE &&
+                    !dovi_nlq_is_mel(hdr, mapping);
+
+    hdr->el_spatial_resampling_filter_flag = 0;
+    hdr->disable_residual_flag = 1;
+
+    mapping->nlq_method_idc = AV_DOVI_NLQ_NONE;
+    mapping->num_x_partitions = 1;
+    mapping->num_y_partitions = 1;
+    memset(mapping->nlq, 0, sizeof(mapping->nlq));
+    memset(mapping->nlq_pivots, 0, sizeof(mapping->nlq_pivots));
+
+    if (fel) {
+        for (int c = 0; c < 3; c++) {
+            AVDOVIReshapingCurve *curve = &mapping->curves[c];
+            memset(curve, 0, sizeof(*curve));
+            curve->num_pivots      = 2;
+            curve->pivots[0]       = 0;
+            curve->pivots[1]       = (1 << hdr->bl_bit_depth) - 1;
+            curve->mapping_idc[0]  = AV_DOVI_MAPPING_POLYNOMIAL;
+            curve->poly_order[0]   = 1;
+            curve->poly_coef[0][1] = 1LL << hdr->coef_log2_denom;
+        }
+    }
+
+    if (memcmp(color, &ff_dovi_color_default, sizeof(*color))) {
+        for (int i = 0; i < 9; i++) {
+            color->ycc_to_rgb_matrix[i] = av_make_q(p81_ycc_to_rgb[i], 1 << 13);
+            color->rgb_to_lms_matrix[i] = av_make_q(p81_rgb_to_lms[i], 1 << 14);
+        }
+        for (int i = 0; i < 3; i++)
+            color->ycc_to_rgb_offset[i] = av_make_q(p81_ycc_to_rgb_offset[i], 1 << 28);
+        color->signal_color_space = 0;
+    }
+}
