# Pre-built FFmpeg with NVENC/NVDEC/CUVID + Vulkan/libplacebo support.
# Build once and tag — reused by Dockerfile.gpu as a cached base.
#
#   docker build -f docker/Dockerfile.ffmpeg -t onscreen-ffmpeg:latest .
#
# CUDA 12.x (NOT 13.x) on purpose: this image ships to self-hosters running a
# wide range of NVIDIA drivers and GPUs. CUDA 13 requires driver >= 580 (only
# released mid-2025) and drops every GPU older than Turing (compute < 7.5). On
# the drivers most distros and NAS appliances actually ship today (535/550/560/
# 570) a CUDA 13 build silently degrades scale_cuda to a software scale, and
# Maxwell/Pascal cards (Quadro P2000, GTX 10-series — extremely common in home
# servers) lose GPU acceleration entirely. CUDA 12.8's PTX JITs on driver
# >= 570 and the toolkit supports Maxwell..Blackwell natively — covering the
# vast majority of deployed hardware while still building for the newest GPUs.
# NVENC/NVDEC ride the codec SDK / CUDA driver API and work on even older
# drivers regardless. Bump only once a 580+ driver is broadly deployed.
ARG CUDA_VERSION=12.8.0
FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu24.04 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential nasm yasm pkg-config git wget \
      libx264-dev libx265-dev libfdk-aac-dev libmp3lame-dev libopus-dev \
      libvorbis-dev libvpx-dev libass-dev libfreetype-dev \
      libgnutls28-dev libzimg-dev ocl-icd-opencl-dev \
      libvulkan-dev meson ninja-build python3-jinja2 libshaderc-dev && \
    rm -rf /var/lib/apt/lists/*

# NVIDIA codec headers (required for nvenc/nvdec)
RUN git clone --depth 1 https://git.videolan.org/git/ffmpeg/nv-codec-headers.git /tmp/nv-codec-headers && \
    cd /tmp/nv-codec-headers && make install

# Vulkan for the libplacebo GPU tonemap. Ubuntu 24.04's libvulkan-dev ships
# Vulkan 1.3.275, but ffmpeg 8.1 requires `require_pkg_config vulkan >= 1.3.277`
# for --enable-vulkan. Overlay newer Khronos headers (so every symbol ffmpeg
# 8.1 references is present) and bump the pkg-config version to clear the gate.
# The loader's SONAME (libvulkan.so.1) is forward-compatible, so the apt
# libvulkan.so.1 — build-time link target and runtime loader — needs no rebuild.
ARG VULKAN_HEADERS_TAG=v1.3.296
RUN git clone --depth 1 --branch ${VULKAN_HEADERS_TAG} https://github.com/KhronosGroup/Vulkan-Headers.git /tmp/vk-headers && \
    cp -r /tmp/vk-headers/include/* /usr/include/ && \
    VKPC="$(find /usr -name vulkan.pc | head -1)" && \
    sed -i 's/^Version:.*/Version: 1.3.296/' "$VKPC" && \
    echo "patched $VKPC -> $(grep ^Version "$VKPC")" && \
    rm -rf /tmp/vk-headers

# libplacebo from source. Ubuntu 24.04 ships 6.338, but ffmpeg 8.1's
# vf_libplacebo.c uses PL_ALPHA_NONE (libplacebo API >= 344, i.e. v7), so the
# distro lib is too old to compile against. Build a pinned v7: meson + ninja,
# python3-jinja2 is a hard dep for the Vulkan glad-loader generation, and
# shaderc compiles GLSL→SPIR-V (required for the Vulkan filter at runtime).
# --libdir=lib puts libplacebo.so + libplacebo.pc in /usr/local/lib so the
# runtime COPY picks the .so up and ffmpeg's pkg-config finds it (same dir
# nv-codec-headers uses). Builds against the newer Vulkan headers overlaid above.
ARG LIBPLACEBO_TAG=v7.349.0
RUN git clone --recursive --depth 1 --shallow-submodules --branch ${LIBPLACEBO_TAG} \
      https://code.videolan.org/videolan/libplacebo.git /tmp/libplacebo && \
    cd /tmp/libplacebo && \
    meson setup build \
      --prefix=/usr/local \
      --libdir=lib \
      --buildtype=release \
      -Ddefault_library=shared \
      -Dvulkan=enabled \
      -Dshaderc=enabled \
      -Ddemos=false \
      -Dtests=false && \
    ninja -C build && \
    ninja -C build install && \
    ldconfig && \
    rm -rf /tmp/libplacebo

ARG FFMPEG_VERSION=8.1
RUN wget -q https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.bz2 -O /tmp/ffmpeg.tar.bz2 && \
    cd /tmp && tar xjf ffmpeg.tar.bz2

RUN cd /tmp/ffmpeg-${FFMPEG_VERSION} && \
    ./configure \
      --prefix=/usr/local \
      --enable-gpl \
      --enable-nonfree \
      --enable-cuda-nvcc \
      --enable-nvenc \
      --enable-nvdec \
      --enable-cuvid \
      --extra-cflags=-I/usr/local/cuda/include \
      --extra-ldflags=-L/usr/local/cuda/lib64 \
      --enable-libx264 \
      --enable-libx265 \
      --enable-libfdk-aac \
      --enable-libmp3lame \
      --enable-libopus \
      --enable-libvorbis \
      --enable-libvpx \
      --enable-libass \
      --enable-libfreetype \
      --enable-libzimg \
      --enable-opencl \
      --enable-vulkan \
      --enable-libplacebo \
      --enable-gnutls \
      --disable-static \
      --enable-shared && \
    make -j$(nproc) && \
    make install

# Runtime image with just the built binaries and libs
FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates tzdata wget \
      libx264-dev libx265-dev libfdk-aac-dev libmp3lame-dev libopus-dev \
      libvorbis-dev libvpx-dev libass-dev libfreetype-dev \
      libgnutls28-dev libzimg-dev ocl-icd-libopencl1 \
      libvulkan1 libshaderc-dev \
      libchromaprint-tools postgresql-client \
      tesseract-ocr tesseract-ocr-eng tesseract-ocr-spa tesseract-ocr-fra \
      tesseract-ocr-deu tesseract-ocr-ita tesseract-ocr-por tesseract-ocr-jpn \
      tesseract-ocr-chi-sim tesseract-ocr-chi-tra tesseract-ocr-kor \
      tesseract-ocr-rus tesseract-ocr-ara && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /etc/OpenCL/vendors && \
    echo "libnvidia-opencl.so.1" > /etc/OpenCL/vendors/nvidia.icd

# libplacebo (Vulkan) GPU HDR→SDR tonemap: ffmpeg is built --enable-libplacebo
# --enable-vulkan against a source-built libplacebo v7 (copied from the builder
# via /usr/local/lib below). The runtime carries the Vulkan loader (libvulkan1)
# and shaderc (libshaderc-dev — libplacebo links it for GLSL→SPIR-V).
# The NVIDIA Vulkan ICD itself is injected by nvidia-container-
# toolkit from the host driver — but ONLY when the container requests the
# `graphics` capability. The GPU deploy must therefore set
# NVIDIA_DRIVER_CAPABILITIES to include graphics (e.g. "all" or
# "compute,video,utility,graphics"); with the default "compute,utility" the
# loader finds no ICD and the worker silently falls back to software zscale.

COPY --from=builder /usr/local/bin/ff* /usr/local/bin/
COPY --from=builder /usr/local/lib/lib*.so* /usr/local/lib/
RUN ldconfig
