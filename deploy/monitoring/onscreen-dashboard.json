      "title": "Active transcode sessions",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max(onscreen_transcode_sessions_active{job=\"onscreen\", instance=~\"$instance\"})",
          "legendFormat": "sessions"
